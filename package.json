{
  "name": "passwordepic-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "dev:lan": "node scripts/serve-lan.mjs dev",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "preview": "npm run build && npm run serve",
    "preview:lan": "npm run build && node scripts/serve-lan.mjs preview",
    "check": "npm run typecheck && npm run check:diagrams && npm run build",
    "typecheck": "tsc --noEmit",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations"
  },
  "dependencies": {
    "@docusaurus/core": "^3.6.0",
    "@docusaurus/preset-classic": "^3.6.0",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.6.0",
    "@docusaurus/tsconfig": "^3.6.0",
    "@docusaurus/types": "^3.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.0"
  },
  "engines": {
    "node": ">=18.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
